        <key>NSUserTrackingUsageDescription</key>
        <string>広告の表示最適化、効果測定、不正防止のために、デバイスの広告識別子（IDFA）などの情報を利用します。他社アプリやWebサイトでの活動情報と関連付けられる場合があります。設定からいつでも変更できます。</string>

    <!-- SKAdNetwork (Google) -->
    <key>SKAdNetworkItems</key>
    <array>
      <dict>
        <key>SKAdNetworkIdentifier</key>
        <string>cstr6suwn9.skadnetwork</string>
      </dict>
    </array>
           <key>NSMicrophoneUsageDescription</key>
           <string>一部の音声機能でマイクを利用する可能性があるためアクセスが必要です。</string>
           <key>NSPhotoLibraryAddUsageDescription</key>
           <string>撮影したトレーニング写真をギャラリーに保存するために使用します。</string>
           <key>NSCameraUsageDescription</key>
           <string>トレーニングの写真を記録するためにカメラを使用します。</string>
</dict>
